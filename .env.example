# 서울 열린데이터광장 Open API 일반 인증키 (없으면 HTML 목록 수집으로 대체)
SEOUL_OPENAPI_KEY=

# Telegram Bot API (발급 방법: docs/TELEGRAM_SETUP.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 처음 수집될 때 관심 시설로 표시할 장소명(쉼표 구분)
DEFAULT_WATCHED_PLACES=마루공원,동부도로사업소 테니스장
# Open API를 쓸 수 없고 관심 시설도 없을 때 HTML 목록을 수집할 지역
DEFAULT_WATCHED_AREAS=강남구
# 주기 수집을 끄려면 false
SCHEDULER_ENABLED=true

# 대시보드 비밀번호. 다른 기기(휴대폰 등)에서 접속하려면 반드시 설정한다.
# 비워 두면 이 컴퓨터에서만 열 수 있다.
DASHBOARD_PASSWORD=

# Docker Compose로 실행할 때 대시보드를 여는 범위와 포트.
# 127.0.0.1: 이 컴퓨터에서만 / 0.0.0.0: 같은 네트워크의 다른 기기에서도 (비밀번호 필수)
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=3000

# SQLite 파일 위치 (Docker Compose에서는 backend/data/tennis_watch.db로 고정된다)
DATABASE_URL=sqlite:///./data/tennis_watch.db
